PORT=3000
KAFKA_BROKER=kafka-wallet-wallet-platform.f.aivencloud.com:25157
# ca.pem de Aiven en una sola línea, con \n en lugar de saltos
KAFKA_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=clave
# Mecanismo SASL del broker: plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_MECHANISM=plain
# Consumer group propio (tópicos: users.created, users.updated, users.deleted)
KAFKA_GROUP_ID=notificaciones-service
# Alternativa a SASL: certificado de cliente (service.cert / service.key en una línea con \n).
# Si se definen ambos, se usan en lugar de usuario/clave (y el puerto es otro).
KAFKA_CERT=
KAFKA_KEY=
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=clave
MAIL_FROM="Wallet <no-reply@tudominio.com>"
# Si se define, se envía por la API de Brevo en lugar de SMTP
BREVO_API_KEY=

# Configuración de base de datos (Supabase/Postgres)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.tu-proyecto
DB_PASSWORD=clave
DB_SSL_MODE=require
